{
  "name": "phaser-game-template",
  "private": true,
  "description": "Phaser 4 game template using Vite and TypeScript.",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "start": "vite --config vite/config.dev.mjs",
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs && phaser-asset-pack-hashing -j -r dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "phaser-asset-pack-hashing": "^1.0.6",
    "terser": "^5.28.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@phaserjs/editor-scripts-base": "^2.0.2",
    "phaser": "^4.1.0"
  }
}
